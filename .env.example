# Copy to .env.local and fill in. Never commit real values.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub App (Settings → Developer settings → GitHub Apps). Server-only.
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=darkterminal-academy
# Paste the PEM with newlines escaped as \n, or as a multi-line quoted value
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
